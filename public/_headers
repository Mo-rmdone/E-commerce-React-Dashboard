# Cloudflare edge cache rules.
#
# Vite fingerprints everything in /assets, so those files are immutable and can
# be cached forever. index.html must never be cached or a deploy would not
# reach anyone still holding the old one.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The dataset and the country boundaries are content-stable but not
# fingerprinted, so they revalidate daily rather than being pinned.
/data/dataset.json
  Cache-Control: public, max-age=86400, must-revalidate

/countries-110m.json
  Cache-Control: public, max-age=86400, must-revalidate

/index.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
