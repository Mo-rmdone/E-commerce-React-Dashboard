{
  "name": "e-commerce-react-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "etl": "node scripts/build-dataset.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:full": "npm run etl && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:preview": "npm run build && wrangler dev"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.127.1",
    "xlsx": "^0.18.5"
  },
  "description": "Interactive analytics dashboard for a global skincare and beauty e-commerce dataset. React + TypeScript + D3 + Framer Motion.",
  "engines": {
    "node": ">=20"
  }
}
