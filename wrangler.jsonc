{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Must match the Workers Builds project name, or CI overrides it and opens a
  // PR to reconcile the mismatch.
  "name": "e-commerce-react-dashboard",
  "compatibility_date": "2026-08-25",

  // A static single-page app: no Worker script, just assets served from the
  // edge. `single-page-application` returns index.html for unknown paths, so a
  // refresh or a shared deep link never 404s.
  //
  // This setting IS the SPA fallback. Do not also ship a `_redirects` file
  // containing `/* /index.html 200`: Workers Static Assets rejects that rule as
  // an infinite loop, because its own html_handling already strips `/index` and
  // the rewrite would re-trigger itself. Cloudflare Pages tolerates the rule;
  // Workers does not, and the deploy fails outright.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
